# Copy to .env and fill in locally. Never commit .env or secrets.

# --- App ---
APP_NAME=ScoutApiV2
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Redis (optional; Compose sets redis://redis:6379/0) ---
# Fail-open: API works without Redis (in-memory scrape cache/guards).
REDIS_URL=
REDIS_CONNECT_TIMEOUT_SECONDS=0.3
REDIS_SOCKET_TIMEOUT_SECONDS=0.5

# --- PostgreSQL / Supabase (required for /match persist and /offers/refresh) ---
# Source of truth for domain data. Redis is cache/coordination only (ADR 0020/0021).
# Use SQLAlchemy + psycopg via DATABASE_URL — never the Supabase Data API / PostgREST
# for backend persistence. Frontend must not connect to Postgres directly.
#
# Local Postgres — pick the host that matches HOW you run the API:
# - Docker Compose (API inside the container): use service hostname `postgres`
DATABASE_URL=postgresql+psycopg://scout:scout@postgres:5432/scoutapi
# - API on the host (uvicorn local) against Compose Postgres published on 5432:
#   DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5432/scoutapi
#
# Supabase (production / hosted) — Dashboard → Connect → connection string:
# Direct (preferred for long-lived API + Alembic on IPv6-capable networks):
#   DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# Session pooler (REQUIRED on IPv4-only networks / Docker Desktop Windows/macOS —
#   db.*.supabase.co often resolves IPv6-only → Network is unreachable):
#   DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Transaction pooler (:6543) — only if needed (serverless); app uses NullPool +
# prepare_threshold=None. Do NOT run `alembic upgrade` against :6543.
#
# Docker entrypoint runs `alembic upgrade head` before API/workers start.
# Set false only when a separate one-shot migrate job already applied schema.
AUTO_MIGRATE=true
#
# Pool / timeouts (QueuePool ignored when URL port is 6543):
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Optional override; Supabase hosts auto-append sslmode=require when unset:
# DATABASE_SSLMODE=require
DATABASE_APPLICATION_NAME=scout-api-v2
#
# Compose-only local Postgres credentials (ignored when pointing DATABASE_URL at Supabase):
POSTGRES_USER=scout
POSTGRES_PASSWORD=scout
POSTGRES_DB=scoutapi
POSTGRES_PORT=5432

# --- API Auth (Supabase Auth — Google). Never put real secrets here. ---
# DENY BY DEFAULT: business routes require Bearer access token.
# AUTH_REQUIRED=false is local/dev/test only — rejected at startup in production.
# Legacy alias: AUTH_ENABLED (same polarity; prefer AUTH_REQUIRED).
AUTH_REQUIRED=true
# Project URL (https://<ref>.supabase.co) — used for JWKS + OAuth authorize.
SUPABASE_URL=
# anon/public key ONLY (server-side PKCE exchange). Never service_role.
SUPABASE_ANON_KEY=
# HS256 legacy/test only. Prefer JWKS (leave empty in production with asymmetric keys).
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Must match Supabase Auth redirect allowlist (API callback).
AUTH_GOOGLE_REDIRECT_URL=http://localhost:8000/auth/callback
# Optional SPA URL after login (token in URL fragment). Must be in CORS list.
AUTH_FRONTEND_SUCCESS_URL=http://localhost:3000/auth/callback
# Comma-separated user UUIDs with admin role (in addition to app_metadata.role).
AUTH_ADMIN_USER_IDS=
# Explicit origins only. Never use * with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Peer IPs allowed to supply X-Forwarded-For (comma-separated). Empty = ignore header.
TRUSTED_PROXY_IPS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_CRAWLER_PER_MINUTE=10

# --- Scraper ---
SCRAPER_USER_AGENT=ScoutApiV2/0.1 (+price-monitoring)
SCRAPER_LOG_LEVEL=INFO
SCRAPER_DEFAULT_CONCURRENCY=2
SCRAPER_DEFAULT_DELAY=2
SCRAPER_DEFAULT_TTL=3600
SCRAPER_RETRY_TIMES=3
SCRAPER_HTTP_TIMEOUT=30
AUTOTHROTTLE_ENABLED=true
AUTOTHROTTLE_START_DELAY=2
AUTOTHROTTLE_MAX_DELAY=60
AUTOTHROTTLE_TARGET_CONCURRENCY=0.5
RETRY_BACKOFF_BASE=1
RETRY_BACKOFF_CAP=60
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=300

# --- Scrape guard (limits bursts that trigger WAF IP bans) ---
SCRAPE_URL_COOLDOWN_SECONDS=300
SCRAPE_DOMAIN_MIN_INTERVAL_SECONDS=15
SCRAPE_RESULT_CACHE_TTL_SECONDS=300
SCRAPE_DISTRIBUTED_LOCK_ENABLED=true
SCRAPE_SINGLE_FLIGHT_LOCK_TTL_SECONDS=180
SCRAPE_SINGLE_FLIGHT_WAIT_SECONDS=120
SCRAPE_DISTRIBUTED_COOLDOWN_ENABLED=true

# --- Legacy / optional proxy seams (not used by Camoufox) ---
ROTATING_PROXIES_ENABLED=false
ROTATING_PROXY_LIST_PATH=
MITMPROXY_ENABLED=false
MITMPROXY_URL=

# --- Camoufox ---
CAMOUFOX_ENABLED=true
CAMOUFOX_HEADLESS=true
CAMOUFOX_HUMANIZE=true
CAMOUFOX_TIMEOUT_MS=90000
CAMOUFOX_SETTLE_MS=5000
CAMOUFOX_MAX_SETTLE_ATTEMPTS=12
CAMOUFOX_DISABLE_COOP=true
CAMOUFOX_WARMUP_ORIGIN=true
# Keep one Camoufox persistent context warm across fetches (ADR 0032).
# AliExpress still uses a fresh temp profile per lookup.
# Profile subdirs per locale avoid cookie mix when fingerprint changes.
CAMOUFOX_WARM_REUSE=true
CAMOUFOX_WARM_MAX_FETCHES=40
# Product Match: wave-2 store concurrency (Camoufox stays on owner thread).
MATCH_STORE_CONCURRENCY=3
# Shopee cost controls (DataImpulse bills primarily by GB transferred).
# once_per_session | always | never — avoid paying for home before every PDP.
SHOPEE_WARMUP_POLICY=once_per_session
# Abort image/media/font on Shopee only (document/script/xhr/fetch stay).
SHOPEE_RESOURCE_BLOCKING_ENABLED=true
# Persistent profile dir inside the container (Compose bind-mounts ./data/…).
# Leave empty to use /home/app/.cache/scout-api/camoufox-profiles/default
CAMOUFOX_USER_DATA_DIR=

# Residential proxy ONLY as classified-block fallback (Proxy Cost Mode).
# All stores try direct first — never force proxy just because this is set.
# Prefer sticky/persistent session (ports 10000-20000), not rotating :823.
# Format: http://USER:PASSWORD@HOST:PORT
# DataImpulse sticky BR example:
#   CAMOUFOX_PROXY_URL=http://USER:PASSWORD@gw.dataimpulse.com:10001
# For Shopee / AliExpress, the fetcher auto-appends __cr.br when missing.
# Seed once (headed): make seed-shopee
CAMOUFOX_PROXY_URL=

# AliExpress (optional tuning — defaults match Proxy Cost Mode + FALLBACK)
# Concurrency/domain interval use SCRAPE_DOMAIN_MIN_INTERVAL_SECONDS.
# Persistent session uses CAMOUFOX_USER_DATA_DIR profiles (direct vs proxied).

# --- Challenge / CAPTCHA resolution (ADR 0017) ---
# When a robot-check/CAPTCHA appears, the fetcher MUST attempt resolution
# before UPSTREAM_BLOCKED. Amazon image captchas use free offline amazoncaptcha
# (no API key). Install: pip install --no-deps -r requirements-captcha.txt
CAPTCHA_SOLVER_ENABLED=true
CAPTCHA_SOLVER_PROVIDER=amazoncaptcha
CAPTCHA_SOLVER_MAX_ATTEMPTS=2

# --- Auth wall bypass (ADR 0018) ---
# Login/session gates that block public offers MUST be resolved in the fetch
# layer. Prefer seeded Camoufox profile (make seed-shopee / seed-mercadolivre).
# Optional operator credentials for Amazon/Shopee login walls (never commit):
AUTH_BYPASS_ENABLED=true
AUTH_BYPASS_MAX_ATTEMPTS=2
AMAZON_AUTH_EMAIL=
AMAZON_AUTH_PASSWORD=
SHOPEE_AUTH_EMAIL=
SHOPEE_AUTH_PASSWORD=
# Mercado Livre: credential-free bypass (Camoufox Snoopy + origin warm +
# persistent profile). Optional warm: make seed-mercadolivre

# --- Product images / Google Drive (ADR 0029) ---
# Dedicated Google account OAuth (offline). Never commit real values.
# Bootstrap: python scripts/google_drive_oauth_bootstrap.py
# Prefer OAuth client type "Desktop app". Web clients need redirect URIs:
#   http://127.0.0.1:8765/
#   http://localhost:8765/
# Scope: https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
IMAGE_MAX_BYTES=8000000
IMAGE_MAX_DIMENSION=4096
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=30
IMAGE_MAX_REDIRECTS=5
IMAGE_MAX_PER_PRODUCT=20
IMAGE_AVIF_QUALITY=60
IMAGE_AVIF_MAX_CONCURRENCY=2
# Alias opcional equivalente: IMAGE_OPTIMIZATION_CONCURRENCY=2
IMAGE_MEDIA_CACHE_MAX_AGE_SECONDS=86400
IMAGE_OPTIMIZATION_ENABLED=true
IMAGE_OPTIMIZATION_SWEEP_INTERVAL_SECONDS=2
IMAGE_OPTIMIZATION_BATCH_SIZE=4
IMAGE_OPTIMIZATION_LEASE_SECONDS=300

# --- Persistent offer monitoring (ADR 0030) ---
# Clock lives in PostgreSQL (store_listings.next_check_at). Worker is a
# separate process — do not rely on FastAPI lifespan for durability.
OFFER_REFRESH_INTERVAL_HOURS=12
OFFER_MONITOR_ENABLED=true
OFFER_MONITOR_SWEEP_INTERVAL_SECONDS=30
OFFER_MONITOR_BATCH_SIZE=10
OFFER_MONITOR_LEASE_SECONDS=300
OFFER_MONITOR_RETRY_BASE_SECONDS=300
OFFER_MONITOR_RETRY_MAX_SECONDS=3600
OFFER_MONITOR_JITTER_SECONDS=600
OFFER_PROMOTION_GRACE_SECONDS=60
OFFER_MONITOR_STALE_HEARTBEAT_SECONDS=300
